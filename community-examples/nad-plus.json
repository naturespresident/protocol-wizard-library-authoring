  "items": [
    {
      "id": "nad-plus",
      "name": "NAD+",
      "aliases": [],
      "kind": "other",
      "identityStatus": "needs_confirmation",
      "categoryID": 6,
      "benefits": "Preliminary disease-specific human evidence: an intravenous NAD+ trial in patients with heart failure caused by ischemic cardiomyopathy found a modest improvement in left-ventricular ejection fraction at one month when added to usual treatment. Differences in six-month clinical events and functional class were not statistically significant. A separate small infusion study measured NAD+ metabolites, not wellness efficacy. These findings do not establish anti-aging, energy, cognition, or addiction-recovery benefits, or efficacy by intramuscular/subcutaneous routes."
    }
  ],
