  "items": [
    {
      "id": "retatrutide-mots-c",
      "name": "Retatrutide + MOTS-c Kombination",
      "aliases": [],
      "kind": "other",
      "identityStatus": "needs_confirmation",
      "categoryID": 2,
      "benefits": "Vorgeschlagene Begründung auf Grundlage der einzelnen Komponenten: Retatrutide hat in Adipositasstudien am Menschen eine Gewichtsreduktion gezeigt, während verabreichtes MOTS-c bei Mäusen Hinweise auf Wirkungen auf den Stoffwechsel und die körperliche Leistungsfähigkeit liefert. Die Kombination zielt daher theoretisch auf Gewichtsmanagement und metabolische Fitness ab. Diese Erkenntnisse zu den Einzelkomponenten belegen weder einen Nutzen der Kombination noch eine Verbesserung der Energie oder einen Muskelerhalt oder additive Wirkungen beim Menschen. Es wurde keine direkte Wirksamkeitsstudie zur Kombination gefunden."
    }
  ],
