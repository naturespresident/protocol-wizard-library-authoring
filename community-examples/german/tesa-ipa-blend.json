        "cautions": {
          "source_id": "d7553c26-f802-491d-945a-dd36ccc1f1bc",
          "source_statements": [
            {
              "section": "Tesamorelin + Ipamorelin Nebenwirkungen & Sicherheit",
              "subsection": "Sicherheit der Einzelwirkstoffe",
              "excerpt": "Zu den in Studien mit tesamorelin am häufigsten gemeldeten unerwünschten Ereignissen gehören Reaktionen an der Injektionsstelle (Rötung, Juckreiz), Gelenkschmerzen (Arthralgie), Schmerzen in den Extremitäten, periphere Ödeme (Flüssigkeitseinlagerungen) und Muskelschmerzen. Tesamorelin wurde außerdem mit Glukoseintoleranz und einem höheren Risiko für Typ-2-Diabetes in Verbindung gebracht und ist in der Schwangerschaft kontraindiziert.",
              "truncated": false
            },
            {
              "section": "Tesamorelin + Ipamorelin Nebenwirkungen & Sicherheit",
              "subsection": "Sicherheit der Einzelwirkstoffe",
              "excerpt": "Ipamorelin wird in Tierstudien und nach den begrenzten Daten beim Menschen im Allgemeinen gut vertragen; vorübergehende Hautrötung oder Kopfschmerzen können auftreten. Da ipamorelin noch keine abgeschlossenen Studien am Menschen durchlaufen hat, ist seine Langzeitsicherheit nicht belegt.",
              "truncated": false
            },
            {
              "section": "Tesamorelin + Ipamorelin Nebenwirkungen & Sicherheit",
              "subsection": "Kombinationsspezifische Unklarheiten",
              "excerpt": "Keine Studie am Menschen hat das Nebenwirkungsprofil speziell dieser Mischung charakterisiert.",
              "truncated": false
            },
            {
              "section": "Tesamorelin + Ipamorelin Nebenwirkungen & Sicherheit",
              "subsection": "Risiken an der Injektionsstelle und Qualitätsrisiken",
              "excerpt": "Der Wechsel der Injektionsstellen zwischen Bauch, Oberschenkel und Oberarm ist eine gängige Praxis zur Vermeidung von Lipohypertrophie.",
              "truncated": false
            }
          ],
          "independent_verification": false
        },
