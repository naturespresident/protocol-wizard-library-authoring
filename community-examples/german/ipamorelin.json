          "source_statements": [
            {
              "section": "Für wen Ipamorelin infrage kommt und wer es meiden sollte",
              "subsection": "Anwendung vermeiden bei",
              "excerpt": "Aktiver oder kürzlich aufgetretener Krebserkrankung. GH und IGF-1 können das Zellwachstum fördern. Personen mit aktueller oder kürzlich aufgetretener Krebserkrankung sollten Substanzen meiden, die den GH-Spiegel erhöhen.",
              "truncated": false
            },
            {
              "section": "Für wen Ipamorelin infrage kommt und wer es meiden sollte",
              "subsection": "Anwendung vermeiden bei",
              "excerpt": "Schwangerschaft oder Stillzeit. Für Ipamorelin liegen in keiner dieser Gruppen Sicherheitsdaten vor.",
              "truncated": false
            },
