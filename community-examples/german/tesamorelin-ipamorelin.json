        "cautions": {
          "source_id": "d7553c26-f802-491d-945a-dd36ccc1f1bc",
          "source_statements": [
            {
              "section": "Tesamorelin + Ipamorelin Nebenwirkungen & Sicherheit",
              "subsection": "Sicherheit der einzelnen Wirkstoffe",
              "excerpt": "Zu den am häufigsten berichteten unerwünschten Ereignissen in Studien zu Tesamorelin gehören Reaktionen an der Injektionsstelle (Rötung, Juckreiz), Gelenkschmerzen (Arthralgie), Schmerzen in den Extremitäten, periphere Ödeme (Flüssigkeitsretention) und Muskelschmerzen. Tesamorelin wurde außerdem mit Glukoseintoleranz und einem höheren Risiko für Typ-2-Diabetes in Verbindung gebracht und ist während der Schwangerschaft kontraindiziert.",
              "truncated": false
            },
            {
              "section": "Tesamorelin + Ipamorelin Nebenwirkungen & Sicherheit",
              "subsection": "Sicherheit der einzelnen Wirkstoffe",
              "excerpt": "Ipamorelin wird in Tierstudien und gemäß den begrenzten Daten am Menschen im Allgemeinen gut vertragen; vorübergehende Hautrötungen oder Kopfschmerzen können auftreten. Da Ipamorelin die Studien am Menschen nicht abgeschlossen hat, ist seine langfristige Sicherheit nicht belegt.",
              "truncated": false
            },
            {
              "section": "Tesamorelin + Ipamorelin Nebenwirkungen & Sicherheit",
              "subsection": "Unbekannte Aspekte der Kombination",
              "excerpt": "Keine Studie am Menschen hat das Nebenwirkungsprofil speziell dieser Mischung charakterisiert.",
              "truncated": false
            },
            {
              "section": "Tesamorelin + Ipamorelin Nebenwirkungen & Sicherheit",
              "subsection": "Risiken an der Injektionsstelle und Qualitätsrisiken",
              "excerpt": "Der Wechsel der Injektionsstellen zwischen Bauch, Oberschenkel und Oberarm ist eine gängige Praxis zur Vermeidung von Lipohypertrophie.",
              "truncated": false
            }
          ],
          "independent_verification": false
        },
