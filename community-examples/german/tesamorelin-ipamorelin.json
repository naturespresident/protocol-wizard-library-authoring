  "items": [
    {
      "id": "tesamorelin-ipamorelin",
      "name": "Tesamorelin + Ipamorelin Kombination",
      "aliases": [],
      "kind": "other",
      "identityStatus": "needs_confirmation",
      "categoryID": 4,
      "benefits": "Vorgeschlagene Begründung: gemeinsame Anwendung zweier Wirkstoffe der GH-Achse, gestützt auf die Evidenz zu Tesamorelin als Einzelwirkstoff hinsichtlich viszeralen Fetts und auf die Forschung zur kurzfristigen Hormonausschüttung durch Ipamorelin. Es wurde keine direkte Wirksamkeitsstudie zu dieser Kombination separater Produkte gefunden. Vorteile eines Inhaltsstoffs belegen weder einen Nutzen der gemeinsamen Anwendung beider Inhaltsstoffe noch einen additiven Effekt oder eine Überlegenheit gegenüber der jeweiligen alleinigen Anwendung. Aussagen zu verbessertem Fettabbau, Muskelaufbau, besserer Regeneration, besserem Schlaf oder Langlebigkeit bleiben für diese Kombination unbestätigt."
    }
  ],
