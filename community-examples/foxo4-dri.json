          "source_statements": [
            {
              "section": "FOXO4-DRI Dosing Context & Schedule",
              "subsection": "No safety data behind this",
              "excerpt": "In the foundational 2017 Cell study, naturally aged mice and chemotherapy-treated mice received FOXO4-DRI at 5 mg/kg by intraperitoneal (IP) injection , given on an intermittent schedule (about three times per week) across several weeks. Treated aged mice showed restored coat density, better kidney markers, and improved physical activity.",
              "truncated": false
            },
            {
              "section": "FOXO4-DRI Side Effects & Safety",
              "subsection": "",
              "excerpt": "There are no documented human side effects because FOXO4-DRI has not been tested in people. In mouse studies, researchers reported improved health markers rather than obvious toxicity, but mouse safety does not predict human safety.",
              "truncated": false
            },
            {
              "section": "FOXO4-DRI Side Effects & Safety",
              "subsection": "Theoretical and reported concerns",
              "excerpt": "Impaired healing: senescent cells help wound repair, so clearing them at the wrong time may not be wanted.",
              "truncated": false
            }
          ],
          "independent_verification": false
        },
