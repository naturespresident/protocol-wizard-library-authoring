          "source_statements": [
            {
              "section": "Tesamorelin + Ipamorelin 부작용 및 안전성",
              "subsection": "개별 화합물의 안전성",
              "excerpt": "tesamorelin 임상시험에서 가장 흔하게 보고된 이상반응에는 주사 부위 반응 (발적, 가려움), 관절 통증 (관절통), 사지 통증, 말초 부종 (체액 저류), 근육통이 포함돼요. Tesamorelin은 내당능 장애 및 제2형 당뇨병 위험 증가와도 관련이 있으며, 임신 중에는 금기예요.",
              "truncated": false
            },
            {
              "section": "Tesamorelin + Ipamorelin 부작용 및 안전성",
              "subsection": "개별 화합물의 안전성",
              "excerpt": "Ipamorelin은 동물 연구와 제한적인 인체 자료에서 일반적으로 내약성이 양호하며, 일시적인 홍조나 두통이 나타날 수 있어요. ipamorelin은 인체 임상시험을 완료하지 않았으므로 장기 안전성이 확립되지 않았어요.",
              "truncated": false
            },
            {
              "section": "Tesamorelin + Ipamorelin 부작용 및 안전성",
              "subsection": "병용 조합에 특유한 미확인 사항",
              "excerpt": "이 혼합 제제의 부작용 양상을 구체적으로 규명한 인체 임상시험은 없어요.",
              "truncated": false
            },
            {
              "section": "Tesamorelin + Ipamorelin 부작용 및 안전성",
              "subsection": "주사 부위 및 품질 관련 위험",
              "excerpt": "지방비대를 피하기 위해 복부, 허벅지, 위팔 사이에서 주사 부위를 번갈아 바꾸는 것이 일반적인 관행이에요.",
              "truncated": false
            }
          ],
