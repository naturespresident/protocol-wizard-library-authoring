        "cautions": {
          "source_id": "3105f833-8eab-4667-83d0-bb0d583ff3fd",
          "source_statements": [
            {
              "section": "CJC-1295(DAC 없음)의 대상자 및 사용을 피해야 하는 대상자",
              "subsection": "대부분의 프로토콜에서 제외하는 집단",
              "excerpt": "활동성 암 또는 최근 암 병력이 있는 경우예요. GH와 IGF-1은 세포 성장에 영향을 줄 수 있으며, 대부분의 계획 수립 체계는 이 집단을 기본적으로 제외해요.",
              "truncated": false
            },
            {
              "section": "CJC-1295(DAC 없음)의 대상자 및 사용을 피해야 하는 대상자",
              "subsection": "대부분의 프로토콜에서 제외하는 집단",
              "excerpt": "임신 중이거나 수유 중인 경우예요.",
              "truncated": false
            },
            {
              "section": "CJC-1295(DAC 없음) 부작용 및 안전성",
              "subsection": "",
              "excerpt": "CJC-1295(DAC 없음)는 화합물 자체가 소실됨에 따라 부작용도 사라지기 때문에 DAC 버전보다 용량을 조절하기 쉽다고 흔히 설명돼요. 보고된 영향의 대부분은 투여 후 30–60분 이내에 사라져요.",
              "truncated": false
            },
            {
              "section": "CJC-1295(DAC 없음) 부작용 및 안전성",
              "subsection": "흔히 보고되는 영향",
              "excerpt": "손의 따끔거림이나 감각 저하가 있으며, 때로는 더 높은 단회 용량과 관련이 있어요.",
              "truncated": false
            },
            {
              "section": "CJC-1295(DAC 없음) 부작용 및 안전성",
              "subsection": "이론적인 장기 우려 사항",
              "excerpt": "DAC가 없는 변형체의 인슐린 감수성과 혈당에 대한 장기적 영향은 충분히 연구되지 않았어요.",
              "truncated": false
            },
            {
              "section": "CJC-1295(DAC 없음) 부작용 및 안전성",
              "subsection": "이론적인 장기 우려 사항",
              "excerpt": "장기간의 IGF-1 상승은 이론적으로 세포 성장에 영향을 미칠 수 있으며, 이는 암 병력을 제외 사유로 취급하는 이유 중 하나예요.",
              "truncated": false
            }
          ],
          "independent_verification": false
        },
