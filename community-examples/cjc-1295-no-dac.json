          "source_statements": [
            {
              "section": "Who CJC-1295 No DAC Is For and Who Should Avoid It",
              "subsection": "Groups Most Protocols Exclude",
              "excerpt": "Active cancer or recent cancer history. GH and IGF-1 can affect cell growth, and most planning frameworks exclude this group by default.",
              "truncated": false
            },
            {
              "section": "Who CJC-1295 No DAC Is For and Who Should Avoid It",
              "subsection": "Groups Most Protocols Exclude",
              "excerpt": "Pregnancy or breastfeeding.",
              "truncated": false
            },
            {
              "section": "CJC-1295 No DAC Side Effects & Safety",
              "subsection": "",
              "excerpt": "CJC-1295 No DAC is often described as easier to titrate than the DAC version because side effects fade with the compound itself. Most reported effects pass within 30–60 minutes of a dose.",
              "truncated": false
            },
            {
              "section": "CJC-1295 No DAC Side Effects & Safety",
              "subsection": "Commonly Reported Effects",
              "excerpt": "Tingling or numbness in the hands, sometimes linked to higher single doses.",
              "truncated": false
            },
            {
              "section": "CJC-1295 No DAC Side Effects & Safety",
              "subsection": "Theoretical Long-Term Concerns",
              "excerpt": "Long-term effects on insulin sensitivity and blood sugar are not well studied for the No DAC variant.",
              "truncated": false
            },
            {
              "section": "CJC-1295 No DAC Side Effects & Safety",
              "subsection": "Theoretical Long-Term Concerns",
              "excerpt": "Long-term IGF-1 elevation has theoretical implications for cell growth, which is one reason cancer history is treated as an exclusion.",
              "truncated": false
            }
          ],
          "independent_verification": false
        },
