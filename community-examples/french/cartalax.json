        "cautions": {
          "source_id": "c73f6041-3727-43c4-8c03-50c56283c25e",
          "source_statements": [
            {
              "section": "Effets indésirables et sécurité du peptide Cartalax",
              "subsection": "",
              "excerpt": "Le profil des effets indésirables de Cartalax chez l’être humain n’est pas bien établi. La plupart des recherches publiées portent sur des cellules en culture plutôt que sur une exposition humaine contrôlée ; la fréquence et la gravité des éventuels effets indésirables sont donc inconnues.",
              "truncated": false
            },
            {
              "section": "Effets indésirables et sécurité du peptide Cartalax",
              "subsection": "Aucun taux fiable d’événements indésirables",
              "excerpt": "Aucun essai contrôlé de grande envergure ne montre à quelle fréquence les effets indésirables de Cartalax surviennent.",
              "truncated": false
            },
            {
              "section": "Effets indésirables et sécurité du peptide Cartalax",
              "subsection": "Effets à long terme inconnus",
              "excerpt": "Les cycles répétés d’injections n’ont pas été suffisamment étudiés pour définir les risques à long terme.",
              "truncated": false
            },
            {
              "section": "Effets indésirables et sécurité du peptide Cartalax",
              "subsection": "Des preuves limitées ne signifient pas une absence de risque",
              "excerpt": "Cartalax n’a pas été suffisamment étudié pour déterminer qui peut l’utiliser en toute sécurité. Les groupes ci-dessous sont mentionnés parce que des données fiables de sécurité chez l’être humain font défaut, et non parce que Cartalax présente des contre-indications démontrées pour chacun de ces groupes.",
              "truncated": false
            },
            {
              "section": "Effets indésirables et sécurité du peptide Cartalax",
              "subsection": "Grossesse et allaitement",
              "excerpt": "Aucune étude fiable sur la sécurité de Cartalax pendant la grossesse ou l’allaitement n’a été identifiée.",
              "truncated": false
            },
            {
              "section": "Effets indésirables et sécurité du peptide Cartalax",
              "subsection": "Il s’agit de limites de précaution",
              "excerpt": "L’absence de données humaines empêche une évaluation fiable des risques. Elle ne devrait pas être interprétée comme une preuve que Cartalax est sûr pour les groupes qui n’ont pas été étudiés.",
              "truncated": false
            }
          ],
