        "cautions": {
          "source_id": "93859e7a-a210-4d19-b4a7-cd856695aa4b",
          "source_statements": [
            {
              "section": "Who Melanotan 2 Is For and Who Should Avoid It",
              "subsection": "Personal or family history of melanoma",
              "excerpt": "Case reports have linked MT-2 use to mole changes and melanoma diagnoses. People with prior skin cancer or strong family history should avoid it.",
              "truncated": false
            },
            {
              "section": "Who Melanotan 2 Is For and Who Should Avoid It",
              "subsection": "Cardiovascular conditions",
              "excerpt": "Flushing, blood pressure changes, and rare reports of more serious events suggest people with uncontrolled cardiovascular disease should avoid use.",
              "truncated": false
            },
            {
              "section": "Who Melanotan 2 Is For and Who Should Avoid It",
              "subsection": "History of priapism or sickle cell trait",
              "excerpt": "Case reports include priapism, which is a prolonged, painful erection that needs medical care. Anyone with a higher baseline risk should avoid MT-2.",
              "truncated": false
            },
            {
              "section": "Who Melanotan 2 Is For and Who Should Avoid It",
              "subsection": "Pregnancy and breastfeeding",
              "excerpt": "No human safety data exists for these groups. MT-2 should not be used during pregnancy or while breastfeeding.",
              "truncated": false
            },
            {
              "section": "Melanotan 2 Side Effects & Safety",
              "subsection": "Dermatologic: darkening moles and new moles",
              "excerpt": "MT-2 can darken existing moles, freckles, and other spots. Case reports describe new moles appearing and rapid changes in old ones after only one or two doses. Because mole changes can sometimes signal melanoma (a serious skin cancer), close monitoring is important.",
              "truncated": false
            }
          ],
          "independent_verification": false
        },
