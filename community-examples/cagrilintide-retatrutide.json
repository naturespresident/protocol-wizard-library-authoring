        "cautions": {
          "source_id": "5814ca5a-fcb2-41f0-971c-748cfb366320",
          "source_statements": [
            {
              "section": "Cagrilintide + Retatrutide Side Effects & Safety",
              "subsection": "",
              "excerpt": "This combination has not been tested in any trial. The safety picture is built from each compound's own data plus what we know from CagriSema. The main concern is stacked GI side effects - both compounds slow digestion through different pathways, so combining them can amplify nausea, vomiting, and constipation.",
              "truncated": false
            },
            {
              "section": "Cagrilintide + Retatrutide Side Effects & Safety",
              "subsection": "Combined and Amplified Concerns",
              "excerpt": "Dysesthesia - unusual skin sensations (retatrutide-specific). Tingling, numbness, or prickling have been reported in retatrutide trials and appear to increase at higher doses. This is a retatrutide signal, not a cagrilintide one. Note the timing if you notice it.",
              "truncated": false
            },
            {
              "section": "Cagrilintide + Retatrutide Side Effects & Safety",
              "subsection": "Combined and Amplified Concerns",
              "excerpt": "Unknown glucagon-amylin interaction. Retatrutide hits the glucagon receptor directly. Cagrilintide acts on calcitonin-related receptors with some glucagon-adjacent effects. The combined effect on blood sugar has not been studied. Anyone with blood-sugar concerns should discuss glucose monitoring with a clinician early in a protocol.",
              "truncated": false
            },
            {
              "section": "Cagrilintide + Retatrutide Side Effects & Safety",
              "subsection": "Common Community-Reported Side Effects",
              "excerpt": "Strong appetite suppression - usually a feature, sometimes uncomfortable.",
              "truncated": false
            },
            {
              "section": "Cagrilintide + Retatrutide Side Effects & Safety",
              "subsection": "Contraindication Signals",
              "excerpt": "Standard conservative practice excludes anyone with active gastrointestinal disease, type 1 diabetes, prior pancreatitis, medullary thyroid carcinoma history, or active cancer from any retatrutide protocol. Adding cagrilintide raises the GI tolerance bar further.",
              "truncated": false
            },
            {
              "section": "Cagrilintide + Retatrutide Side Effects & Safety",
              "subsection": "When to reassess",
              "excerpt": "If",
              "truncated": true
            }
          ],
          "independent_verification": false
        },
