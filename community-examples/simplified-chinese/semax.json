          "source_tables": [
            {
              "section": "Semax 的储存与处理",
              "subsection": "",
              "rows": [
                [
                  "状态",
                  "储存",
                  "备注"
                ],
                [
                  "冻干品（粉末，密封小瓶）",
                  "长期储存：-4°F（-20°C）；短期储存：冰箱冷藏（35.6-46.4°F／2-8°C）",
                  "保持密封并避光。核实供应商标签。"
                ],
                [
                  "复溶后（皮下注射溶液）",
                  "35.6-46.4°F（2-8°C）",
                  "根据供应商标签及抑菌水的使用期限指引，在数周内使用。"
                ],
                [
                  "鼻内给药溶液",
                  "多数标签：建议冰箱冷藏（35.6-46.4°F／2-8°C）；部分制造商允许在低于 50°F（10°C）的阴凉干燥处储存",
                  "英国 NIBSC 参考资料建议约 39°F（4°C）。核实具体瓶身标签。"
                ],
                [
                  "所有剂型",
                  "避免阳光直射；避免温度反复变化",
                  "反复冻融或受热会增加聚集风险。"
                ]
              ]
            }
          ]
        },
        "cautions": {
          "source_id": "948335a5-6c26-4139-ae6b-55cd732bdb91",
          "source_statements": [
            {
              "section": "Semax 的适用人群及应避免使用的人群",
              "subsection": "妊娠期或哺乳期人群",
              "excerpt": "人体研究不足，无法评估对胎儿或婴儿的安全性。ADDF 将妊娠期和哺乳期列为禁忌证。",
              "truncated": false
            },
            {
              "section": "Semax 的适用人群及应避免使用的人群",
              "subsection": "基线焦虑水平较高的人群",
              "excerpt": "一项 1996 年研究描述了部分研究受试者中的致焦虑作用，提示 Semax 可加重已有焦虑者的焦虑。对于希望感觉更平静的目标，Selank 通常比 Semax 更适合。",
              "truncated": false
            },
            {
              "section": "Semax 的适用人群及应避免使用的人群",
              "subsection": "正在服用精神科药物或兴奋剂类药物的人群",
              "excerpt": "在动物模型中，Semax 与单胺能系统存在相互作用。与 SSRIs、SNRIs、MAOIs、兴奋剂或影响睡眠的药物合用时，应由临床医生监督。",
              "truncated": false
            },
            {
              "section": "Semax 的副作用与安全性",
              "subsection": "",
              "excerpt": "可获取的英文文献中，关于 Semax 安全性的报告很少。最清晰的总结来自阿尔茨海默病药物发现基金会（2020），其指出，尽管开展了许多临床前试验，但“关于潜在副作用的人体证据非常有限”。2022 年《Pharmaceutics》关于俄罗斯肽类生物药的综述也支持低毒性这一表述。",
              "truncated": false
            },
            {
              "section": "Semax 的副作用与安全性",
              "subsection": "焦虑／过度兴奋",
              "excerpt": "部分使用者描述有“过度兴奋”的感觉，尤其是在与咖啡因、兴奋剂叠加使用，或在一天较晚时使用的情况下。",
              "truncated": false
            },
            {
              "section": "Semax 的作用时间进程与监测事项",
              "subsection": "",
              "excerpt": "文献和研究社区讨论中报告的 Semax 作用时间进程",
              "truncated": true
            }
          ],
          "independent_verification": false
        },
