  "items": [
    {
      "id": "ipamorelin",
      "name": "Ipamorelin",
      "aliases": [],
      "kind": "product",
      "identityStatus": "needs_confirmation",
      "categoryID": 4,
      "benefits": "已证实的生物学效应：在一项小规模人体志愿者药理学研究中，可引起短暂的生长激素释放。这属于生物标志物反应，尚未证实对肌肉增长、恢复、睡眠、减脂或延寿有益。一项针对术后肠麻痹的随机试验，在其主要的进食耐受性终点上未显示具有统计学意义的改善。这些静脉给药研究也未能确立本资料库中皮下给药的健康管理方案或含 ipamorelin 的联合方案具有临床获益。"
    }
  ],
