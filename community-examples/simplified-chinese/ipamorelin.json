          "source_statements": [
            {
              "section": "Ipamorelin 的适用人群及应避免使用的人群",
              "subsection": "以下人群应避免使用",
              "excerpt": "活动性癌症或近期患过癌症。生长激素和 IGF-1 可促进细胞生长。目前患有癌症或近期患过癌症的任何人都应避免使用升高生长激素的化合物。",
              "truncated": false
            },
            {
              "section": "Ipamorelin 的适用人群及应避免使用的人群",
              "subsection": "以下人群应避免使用",
              "excerpt": "妊娠期或哺乳期。这两类人群均无 ipamorelin 的安全性数据。",
              "truncated": false
            },
            {
              "section": "Ipamorelin 的适用人群及应避免使用的人群",
              "subsection": "存在以下情况时需格外谨慎",
              "excerpt": "显著的癌症家族史。",
              "truncated": false
            },
            {
              "section": "Ipamorelin 的适用人群及应避免使用的人群",
              "subsection": "存在以下情况时需格外谨慎",
              "excerpt": "糖尿病前期或空腹血糖接近正常范围上限。",
              "truncated": false
            },
            {
              "section": "Ipamorelin 的适用人群及应避免使用的人群",
              "subsection": "监测的界限",
              "excerpt": "部分执业医务人员会在长期 ipamorelin 方案开始前及实施期间检查空腹血糖和 HbA1c。本页面不构成医疗建议。任何关于开始、继续或停止使用研究用化合物的决定，均应由个人与其执业临床医生共同作出。",
              "truncated": false
            }
