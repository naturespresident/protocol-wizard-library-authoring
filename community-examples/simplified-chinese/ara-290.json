    {
      "id": "ara-290",
      "name": "ARA-290",
      "aliases": [],
      "kind": "product",
      "identityStatus": "needs_confirmation",
      "categoryID": 5,
      "benefits": "初步人体研究证据：一项针对结节病相关小纤维神经病患者的小型盲法安慰剂对照试验显示，皮下注射 ARA-290 可改善神经病变症状、角膜小神经纤维密度及六分钟步行能力。这些结果仅适用于所研究的疾病人群，仍处于研究阶段；并不能证明其对健康人群具有普遍的神经再生或恢复益处。"
    }
  ],
