        "cautions": {
          "source_id": "d7553c26-f802-491d-945a-dd36ccc1f1bc",
          "source_statements": [
            {
              "section": "Tesamorelin + Ipamorelin 的副作用与安全性",
              "subsection": "化合物层面的安全性",
              "excerpt": "在 tesamorelin 试验中，最常报告的不良事件包括注射部位反应（发红、瘙痒）、关节疼痛（关节痛）、肢体疼痛、外周水肿（液体潴留）和肌肉酸痛。Tesamorelin 还与葡萄糖耐量受损及 2 型糖尿病风险升高有关，且妊娠期禁用。",
              "truncated": false
            },
            {
              "section": "Tesamorelin + Ipamorelin 的副作用与安全性",
              "subsection": "化合物层面的安全性",
              "excerpt": "在动物研究和有限的人体数据中，Ipamorelin 总体耐受性良好；可能出现短暂潮红或头痛。由于 ipamorelin 尚未完成人体试验，其长期安全性尚未确立。",
              "truncated": false
            },
            {
              "section": "Tesamorelin + Ipamorelin 的副作用与安全性",
              "subsection": "联合方案特有的未知因素",
              "excerpt": "尚无人体试验专门描述该混合制剂的副作用特征。",
              "truncated": false
            },
            {
              "section": "Tesamorelin + Ipamorelin 的副作用与安全性",
              "subsection": "注射部位与质量风险",
              "excerpt": "在腹部、大腿和上臂之间轮换注射部位，是避免脂肪增生的常见做法。",
              "truncated": false
            }
          ],
          "independent_verification": false
        },
