        "cautions": {
          "source_id": "cb486916-f61f-4885-8c92-bf7c2ac3f77f",
          "source_statements": [
            {
              "section": "CagriSema 副作用与安全性",
              "subsection": "两项试验中的共同规律",
              "excerpt": "恶心、呕吐和腹泻在剂量递增期间达到高峰，并在维持阶段逐渐减轻；便秘在整个试验期间相对稳定。申办方称，其安全性特征与 GLP-1 受体激动剂这一更广泛药物类别的安全性特征相当。PepPal 面向 GLP-1 使用者的配套补充剂指南涵盖蛋白质、膳食纤维、电解质以及基于实验室检查结果的营养支持。",
              "truncated": false
            },
            {
              "section": "CagriSema 副作用与安全性",
              "subsection": "联用组合特有的未知因素与质量风险",
              "excerpt": "尚无已发表的试验将 CagriSema 与研究用途的同等配制制剂进行直接比较。由于 CagriSema 仍处于研究阶段，任何未经 FDA 批准或经配制的产品在使用前都必须评估其身份、纯度和污染风险。FDA 于 2026 年初重点提及了针对配制药物中未经批准的 GLP-1 活性成分的执法行动，这凸显了质量控制方面的担忧。",
              "truncated": false
            }
          ],
          "independent_verification": false
        },
