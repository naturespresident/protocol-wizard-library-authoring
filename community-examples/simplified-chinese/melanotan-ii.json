        "cautions": {
          "source_id": "93859e7a-a210-4d19-b4a7-cd856695aa4b",
          "source_statements": [
            {
              "section": "Melanotan 2 的适用人群与应避免使用的人群",
              "subsection": "黑色素瘤个人史或家族史",
              "excerpt": "病例报告将 MT-2 的使用与痣的变化及黑色素瘤诊断联系起来。有皮肤癌既往史或显著家族史的人应避免使用。",
              "truncated": false
            },
            {
              "section": "Melanotan 2 的适用人群与应避免使用的人群",
              "subsection": "心血管疾病",
              "excerpt": "潮红、血压变化以及罕见的更严重事件报告提示，心血管疾病未得到控制的人应避免使用。",
              "truncated": false
            },
            {
              "section": "Melanotan 2 的适用人群与应避免使用的人群",
              "subsection": "阴茎异常勃起病史或镰状细胞性状",
              "excerpt": "病例报告包括阴茎异常勃起，即持续时间过长且伴有疼痛、需要医疗救治的勃起。任何基线风险较高的人都应避免使用 MT-2。",
              "truncated": false
            },
            {
              "section": "Melanotan 2 的适用人群与应避免使用的人群",
              "subsection": "妊娠与哺乳",
              "excerpt": "这些人群尚无人类安全性数据。妊娠期间或哺乳期间不应使用 MT-2。",
              "truncated": false
            },
            {
              "section": "Melanotan 2 的副作用与安全性",
              "subsection": "皮肤方面：痣的颜色加深与新痣出现",
              "excerpt": "MT-2 可使现有的痣、雀斑及其他斑点颜色加深。病例报告描述，仅使用一到两次后就出现了新痣，旧痣也发生了快速变化。由于痣的变化有时可能提示黑色素瘤（一种严重的皮肤癌），密切监测很重要。",
              "truncated": false
            }
          ],
          "independent_verification": false
        },
