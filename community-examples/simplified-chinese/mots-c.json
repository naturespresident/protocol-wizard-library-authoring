    {
      "id": "mots-c",
      "name": "MOTS-C",
      "aliases": [],
      "kind": "product",
      "identityStatus": "needs_confirmation",
      "categoryID": 2,
      "benefits": "临床前证据：在小鼠研究中，给予 MOTS-c 改善了代谢稳态和胰岛素敏感性，并提高了年轻和老年小鼠的运动表现。运动研究中的人体部分测量的是机体自身的 MOTS-c 对运动的反应，并未将注射 MOTS-c 作为治疗进行测试。在所找到的一手证据中，尚未确立其对人体减重、运动表现、肌肉保留或抗衰老的益处。"
    }
  ],
