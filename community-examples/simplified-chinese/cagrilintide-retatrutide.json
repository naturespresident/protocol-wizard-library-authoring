  "items": [
    {
      "id": "cagrilintide-retatrutide",
      "name": "Cagrilintide + Retatrutide 联用方案",
      "aliases": [],
      "kind": "other",
      "identityStatus": "needs_confirmation",
      "categoryID": 2,
      "benefits": "直接的联合用药证据来自临床前研究：在饮食诱导肥胖的雄性大鼠中，cagrilintide 联合 retatrutide 降低了体重和摄食量，并改善了血液中的胆固醇、甘油三酯和胰岛素指标。在该实验中，联合用药的效果优于所比较的单药治疗。未发现已证实的人体联合用药获益；这些动物研究结果不能验证人体联用方案的有效性，也不能确立临床协同作用。"
    }
  ],
