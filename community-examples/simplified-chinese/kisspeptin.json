    {
      "id": "kisspeptin",
      "name": "Kisspeptin",
      "aliases": [],
      "kind": "product",
      "identityStatus": "needs_confirmation",
      "categoryID": 6,
      "benefits": "研究中的潜在获益取决于肽的变体和临床情境。Kisspeptin-54 可在接受 IVF 的女性中诱导卵子成熟，一项针对卵巢过度刺激高风险女性的随机研究发现，第二次给药可提高成熟卵子的获取量。针对性欲低下人群的小规模 kisspeptin-54 急性给药研究还报告了大脑对性刺激的处理及性唤起方面的变化。这些发现尚不能确立未明确具体类型的 kisspeptin 产品可用于常规生育治疗或性欲低下治疗。"
    }
  ],
