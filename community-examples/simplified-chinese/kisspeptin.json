        "cautions": {
          "source_id": "260c205e-183a-4795-aae6-4d22e1f6a80a",
          "source_statements": [
            {
              "section": "Kisspeptin 的适用人群与应避免使用的人群",
              "subsection": "",
              "excerpt": "人体 kisspeptin 研究主要涉及健康成年男性、绝经前女性、因激素信号低下而闭经的女性、IVF 触发研究，以及患有性欲减退障碍的男性和女性。在这些研究情境之外，证据仍然有限。",
              "truncated": false
            },
            {
              "section": "Kisspeptin 的适用人群与应避免使用的人群",
              "subsection": "",
              "excerpt": "妊娠与哺乳：Kisspeptin 与妊娠和生殖周期相关。尚无充分的安全性数据支持在妊娠或哺乳期间使用。",
              "truncated": false
            },
            {
              "section": "Kisspeptin 的适用人群与应避免使用的人群",
              "subsection": "",
              "excerpt": "激素敏感性癌症：Kisspeptin 可影响性激素信号。对于有乳腺癌、卵巢癌或前列腺癌病史的人群，这一点需予以重视。",
              "truncated": false
            },
            {
              "section": "Kisspeptin 的适用人群与应避免使用的人群",
              "subsection": "",
              "excerpt": "临床试验之外正在进行的生育治疗：不要在缺乏临床监测的情况下尝试照搬 IVF 触发方案。时机、实验室检测和超声检查都很重要。",
              "truncated": false
            },
            {
              "section": "Kisspeptin 的适用人群与应避免使用的人群",
              "subsection": "",
              "excerpt": "儿童或青少年使用：Kisspeptin 参与青春期启动时机的调控。不应在儿童或青少年中随意使用。",
              "truncated": false
            },
            {
              "section": "Kisspeptin 的副作用与安全性",
              "subsection": "",
              "excerpt": "在已发表的人体研究中，kisspeptin-10 和 kisspeptin-54 在短期使用时通常具有良好的耐受性。针对性欲低下的研究未报告与治疗相关的严重不良事件。IVF 触发研究报告了轻微事件，但未发现明确与 kisspeptin-54 相关的严重药物不良事件。",
              "truncated": false
            },
            {
              "section": "Kisspeptin 的副作用与安全性",
              "subsection": "理论风险与长期使用风险",
              "excerpt": "扰乱正常的 GnRH 脉冲时序。GnRH 是启动 LH 和 FSH 释放的大脑信号。",
              "truncated": false
            },
            {
              "section": "Kisspeptin 的副作用与安全性",
              "subsection": "理论风险与长期使用风险",
              "excerpt": "未知",
              "truncated": true
            }
          ],
          "independent_verification": false
        },
