  "items": [
    {
      "id": "retatrutide-mots-c",
      "name": "Retatrutide + MOTS-c 组合",
      "aliases": [],
      "kind": "other",
      "identityStatus": "needs_confirmation",
      "categoryID": 2,
      "benefits": "基于各组分独立研究提出的理论依据：retatrutide 已在人体肥胖试验中显示出减重效果，而给予 MOTS-c 在小鼠中显示出代谢和体能表现方面的信号。因此，该组合在理论上旨在促进体重管理和代谢健康。这些组分研究结果并不能证明使用该组合对人体有益、能够改善精力或保留肌肉，也不能证明其在人体中具有叠加效应。尚未找到直接研究该组合疗效的研究。"
    }
  ],
