        "cautions": {
          "source_id": "4dc1efbf-e455-42c7-961e-c9ca2d8783e2",
          "source_statements": [
            {
              "section": "Selank 适用人群与应避免使用的人群",
              "subsection": "研究人员和临床医生通常会在以下情况下避免使用 Selank：",
              "excerpt": "受试者处于妊娠期、哺乳期或备孕期——目前没有这些人群的人体安全性数据。",
              "truncated": false
            },
            {
              "section": "Selank 适用人群与应避免使用的人群",
              "subsection": "研究人员和临床医生通常会在以下情况下避免使用 Selank：",
              "excerpt": "受试者已在未经临床医生监督的情况下使用处方抗焦虑药、抗抑郁药或镇静药，因为联合使用的效果尚未经过正式研究。",
              "truncated": false
            },
            {
              "section": "Selank 副作用与安全性",
              "subsection": "",
              "excerpt": "已发表的俄罗斯试验记录显示，Selank 的副作用表现尤为轻微。与苯二氮䓬类药物直接比较时，Selank 产生了相似的焦虑缓解效果，且未出现镇静、依赖、记忆问题、耐受或戒断反应。",
              "truncated": false
            },
            {
              "section": "Selank 副作用与安全性",
              "subsection": "理论风险",
              "excerpt": "药物相互作用。与处方抗焦虑药、抗抑郁药及镇静药联合使用的效果尚未经过正式研究。",
              "truncated": false
            },
            {
              "section": "Selank 副作用与安全性",
              "subsection": "理论风险",
              "excerpt": "长期影响尚不明确。大多数已发表证据涉及 14-21 天的疗程。长期安全性数据有限。",
              "truncated": false
            },
            {
              "section": "Selank 起效时间与监测事项",
              "subsection": "",
              "excerpt": "Selank 的舒缓效果在数天内逐渐累积，而非数分钟内。俄罗斯试验报告描述了在 14 天疗程中有意义的抗焦虑改善。社区使用者通常描述在 3-7 天内出现明显变化。",
              "truncated": false
            }
          ],
