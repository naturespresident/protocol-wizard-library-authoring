        "cautions": {
          "source_id": "3105f833-8eab-4667-83d0-bb0d583ff3fd",
          "source_statements": [
            {
              "section": "CJC-1295 No DAC 的适用人群与应避免使用的人群",
              "subsection": "大多数方案排除的人群",
              "excerpt": "活动性癌症或近期癌症病史。GH 和 IGF-1 可影响细胞生长，大多数计划框架默认排除此类人群。",
              "truncated": false
            },
            {
              "section": "CJC-1295 No DAC 的适用人群与应避免使用的人群",
              "subsection": "大多数方案排除的人群",
              "excerpt": "妊娠期或哺乳期。",
              "truncated": false
            },
            {
              "section": "CJC-1295 No DAC 副作用与安全性",
              "subsection": "",
              "excerpt": "CJC-1295 No DAC 常被描述为比 DAC 版本更容易进行剂量滴定，因为副作用会随化合物本身的消退而减弱。多数报告的反应在给药后 30–60 分钟内消退。",
              "truncated": false
            },
            {
              "section": "CJC-1295 No DAC 副作用与安全性",
              "subsection": "常见的报告反应",
              "excerpt": "手部刺痛或麻木，有时与较高的单次剂量有关。",
              "truncated": false
            },
            {
              "section": "CJC-1295 No DAC 副作用与安全性",
              "subsection": "理论上的长期风险",
              "excerpt": "对于无 DAC 变体，其对胰岛素敏感性和血糖的长期影响尚未得到充分研究。",
              "truncated": false
            },
            {
              "section": "CJC-1295 No DAC 副作用与安全性",
              "subsection": "理论上的长期风险",
              "excerpt": "IGF-1 长期升高在理论上会对细胞生长产生影响，这也是将癌症病史列为排除条件的原因之一。",
              "truncated": false
            }
          ],
          "independent_verification": false
        },
