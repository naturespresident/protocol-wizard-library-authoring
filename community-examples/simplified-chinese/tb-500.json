        "cautions": {
          "source_id": "867ac322-6469-437e-a7d1-9a4a31ae8c47",
          "source_statements": [
            {
              "section": "TB-500 研究适用人群及应避免使用的人群",
              "subsection": "接受药物检测的运动员",
              "excerpt": "WADA 在 S0 类（未获批准的物质）中明确规定，TB-500 及所有 thymosin beta-4 衍生物在任何时候均被禁用。据报告，检测窗口为 30-45 天。参加 WADA 检测项目的运动员、NCAA 运动员以及接受遵循 WADA 标准检测的军人应避免使用。",
              "truncated": false
            },
            {
              "section": "TB-500 研究适用人群及应避免使用的人群",
              "subsection": "现患癌症或有癌症病史的人群",
              "excerpt": "文献中，Tbeta-4 与某些肿瘤模型中转移潜能增加有关。对现患癌症或有癌症病史者而言，这属于理论上的担忧，并在研究用途的安全性讨论中被持续提示，并非已确定的临床风险。",
              "truncated": false
            },
            {
              "section": "TB-500 研究适用人群及应避免使用的人群",
              "subsection": "妊娠与哺乳期",
              "excerpt": "没有人体数据确立其在妊娠或哺乳期的安全性。在这些情况下应避免使用。",
              "truncated": false
            },
            {
              "section": "TB-500 副作用与安全性",
              "subsection": "",
              "excerpt": "由 7 个氨基酸组成的 TB-500 片段基本没有直接的人体安全性数据。最接近的参考是一项全长 thymosin beta-4 的 1 期研究。在该研究中，40 名健康志愿者连续 14 天每天接受最高 1260 mg 的静脉给药，未发生严重不良事件",
              "truncated": true
            }
          ],
          "independent_verification": false
        },
