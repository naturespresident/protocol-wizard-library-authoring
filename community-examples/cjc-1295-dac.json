          "source_statements": [
            {
              "section": "Who CJC-1295 with DAC Is For and Who Should Avoid It",
              "subsection": "",
              "excerpt": "Active or recent malignancy: GH/IGF-1 elevation is generally avoided in cancer contexts.",
              "truncated": false
            },
            {
              "section": "Who CJC-1295 with DAC Is For and Who Should Avoid It",
              "subsection": "",
              "excerpt": "Pregnancy or lactation: no human safety data.",
              "truncated": false
            },
            {
              "section": "Who CJC-1295 with DAC Is For and Who Should Avoid It",
              "subsection": "Long half-life implication",
              "excerpt": "Because CJC-1295 with DAC stays active for 6-8 days, any adverse effect can persist for days rather than clearing in hours. That makes professional oversight especially important.",
              "truncated": false
            },
            {
              "section": "CJC-1295 with DAC Side Effects & Safety",
              "subsection": "",
              "excerpt": "Phase 1 data described CJC-1295 with DAC as relatively well tolerated at lower dose ranges, with adverse events increasing at higher exposure. The most important safety signal in the published record came from the halted Phase 2 trial.",
              "truncated": false
            },
            {
              "section": "CJC-1295 with DAC Side Effects & Safety",
              "subsection": "DAC-specific consideration",
              "excerpt": "Because the half-life is 6-8 days, side effects can persist for days rather than minutes. That is the most important practical difference from shorter-acting GHRH analogs.",
              "truncated": false
            }
          ],
