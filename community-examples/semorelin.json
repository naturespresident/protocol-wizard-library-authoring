        "cautions": {
          "source_id": "ae08de8a-7d40-4f1c-8a04-500de05bcba9",
          "source_statements": [
            {
              "section": "Who Sermorelin Is For and Who Should Avoid It",
              "subsection": "",
              "excerpt": "Sermorelin is typically discussed in two settings: pediatric GH deficiency in the historical FDA-era label, and adult off-label use through 503A or 503B compounding pharmacies for GH optimization, sleep, and body composition. Both should involve a licensed clinician.",
              "truncated": false
            },
            {
              "section": "Who Sermorelin Is For and Who Should Avoid It",
              "subsection": "Who Generally Avoids Sermorelin",
              "excerpt": "Pregnancy or breastfeeding. The FDA-era label flagged sermorelin as Pregnancy Category C. There are no controlled studies in pregnant women, and it is unknown whether sermorelin passes into breast milk.",
              "truncated": false
            },
            {
              "section": "Who Sermorelin Is For and Who Should Avoid It",
              "subsection": "Who Generally Avoids Sermorelin",
              "excerpt": "Active cancer. GH and IGF-1 can act as growth signals on existing cells. Most protocols screen for active malignancy before starting.",
              "truncated": false
            },
            {
              "section": "Who Sermorelin Is For and Who Should Avoid It",
              "subsection": "Who Generally Avoids Sermorelin",
              "excerpt": "Growth hormone deficiency from an intracranial lesion - the FDA-era label specifically said these patients were not studied and were not recommended for sermorelin therapy.",
              "truncated": false
            },
            {
              "section": "Sermorelin Side Effects & Safety",
              "subsection": "Things to Monitor",
              "excerpt": "Hypothyroidism. About 6.5% of trial participants developed hypothyroidism. Untreated hypothyroidism reduces the body's response to GH stimulation, so baseline and follow-up thyroid labs are standard practice.",
              "truncated": false
            }
          ],
          "independent_verification": false
        },
