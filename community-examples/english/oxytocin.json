  "items": [
    {
      "id": "oxytocin",
      "name": "Oxytocin",
      "aliases": [],
      "kind": "product",
      "identityStatus": "needs_confirmation",
      "categoryID": 6,
      "benefits": "Established benefits are obstetric: medically indicated induction or reinforcement of labor, and uterine contraction to control postpartum bleeding, using regulated injectable oxytocin in clinical care. These indications do not demonstrate benefits for the library's intranasal social-cognition or subcutaneous community protocols. Intranasal oxytocin remains investigational for neuropsychiatric uses; a large 24-week autism trial found no significant improvement over placebo in social or cognitive functioning. General trust, bonding, and libido benefits are not established here."
    }
  ],
