        "cautions": {
          "source_id": "d7553c26-f802-491d-945a-dd36ccc1f1bc",
          "source_statements": [
            {
              "section": "Tesamorelin + Ipamorelin Side Effects & Safety",
              "subsection": "Compound-level safety",
              "excerpt": "From tesamorelin trials, the most commonly reported adverse events include injection-site reactions (redness, itching), joint pain (arthralgia), pain in the extremities, peripheral edema (fluid retention), and muscle aches. Tesamorelin has also been linked to glucose intolerance and a higher risk of type 2 diabetes, and is contraindicated in pregnancy.",
              "truncated": false
            },
            {
              "section": "Tesamorelin + Ipamorelin Side Effects & Safety",
              "subsection": "Compound-level safety",
              "excerpt": "Ipamorelin is generally well tolerated in animal studies and the limited human data; transient flushing or headache may occur. Because ipamorelin has not completed human trials, its long-term safety is not established.",
              "truncated": false
            },
            {
              "section": "Tesamorelin + Ipamorelin Side Effects & Safety",
              "subsection": "Stack-specific unknowns",
              "excerpt": "No human trial has characterized the side-effect profile of the blend specifically.",
              "truncated": false
            },
            {
              "section": "Tesamorelin + Ipamorelin Side Effects & Safety",
              "subsection": "Injection-site and quality risks",
              "excerpt": "Rotating sites between abdomen, thigh, and upper arm is a common practice to avoid lipohypertrophy.",
              "truncated": false
            }
          ],
          "independent_verification": false
        },
