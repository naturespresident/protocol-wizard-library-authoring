  "items": [
    {
      "id": "tesa-ipa-blend",
      "name": "Tesa/Ipa blend",
      "aliases": [],
      "kind": "blend",
      "identityStatus": "needs_confirmation",
      "categoryID": 4,
      "benefits": "Proposed component-based rationale: combine tesamorelin's GH-axis activity and condition-specific visceral-fat research with ipamorelin's GH-release effect. No direct clinical benefit study of these premixes was located. Tesamorelin's established benefit in HIV-associated lipodystrophy belongs to its studied single-drug formulation; it does not establish weight-loss, recovery, or muscle benefits for a tesamorelin/ipamorelin blend. Different ratios also remain distinct, unvalidated formulations rather than interchangeable studied products."
    }
  ],
