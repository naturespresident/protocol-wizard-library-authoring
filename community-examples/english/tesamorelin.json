  "items": [
    {
      "id": "tesamorelin",
      "name": "Tesamorelin",
      "aliases": [],
      "kind": "product",
      "identityStatus": "resolved",
      "categoryID": 2,
      "benefits": "Established benefit: reduction of excess abdominal visceral fat in adults with HIV-associated lipodystrophy using the approved tesamorelin formulation. This is a specific fat-distribution indication, rather than general weight-loss treatment; the product is described as weight-neutral. Its GH/IGF-1 effects do not establish better athletic performance, recovery, longevity, or general wellness. The indication and evidence should not be extended automatically to people without HIV lipodystrophy or to ipamorelin-containing combinations."
    }
  ],
