    {
      "id": "glp-2",
      "name": "Tirzepatide",
      "aliases": [],
      "kind": "product",
      "identityStatus": "resolved",
      "categoryID": 2,
      "benefits": "Established benefits for approved subcutaneous tirzepatide products include weight loss and long-term weight maintenance in eligible adults, improved glucose control in type 2 diabetes, and treatment of moderate-to-severe obstructive sleep apnea in adults with obesity. The current Mounjaro label also includes reduction of major cardiovascular events in high-risk adults with type 2 diabetes. These are product- and population-specific benefits; evidence for tirzepatide alone does not establish benefits of stacks containing it."
    }
  ],
