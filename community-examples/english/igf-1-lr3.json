    {
      "id": "igf-1-lr3",
      "name": "IGF-1 LR3",
      "aliases": [],
      "kind": "product",
      "identityStatus": "needs_confirmation",
      "categoryID": 4,
      "benefits": "Preclinical finding: Long R3 IGF-I showed anabolic effects and improved nitrogen retention in rats made catabolic with dexamethasone. Other animal work found intestinal or organ growth, which should not be assumed to represent a health benefit. No direct human clinical benefit for IGF-1 LR3 was verified in this search. Findings and approved uses of native IGF-1 or mecasermin cannot be transferred to this modified analogue."
    }
  ],
