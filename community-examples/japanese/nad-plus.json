          "source_statements": [
            {
              "section": "NAD+の対象となる人と避けるべき人",
              "subsection": "",
              "excerpt": "妊娠・授乳中 — 安全性データが不足しています。",
              "truncated": false
            },
            {
              "section": "NAD+の対象となる人と避けるべき人",
              "subsection": "",
              "excerpt": "活動性の悪性腫瘍 — NAD+は細胞増殖を支え、がん細胞でも増殖を支える可能性があります。腫瘍専門医への相談が不可欠です。",
              "truncated": false
            },
            {
              "section": "NAD+の対象となる人と避けるべき人",
              "subsection": "",
              "excerpt": "血糖降下薬を使用している人 — NAD+は時間の経過とともにインスリン感受性を高める可能性があります。より綿密な血糖モニタリングが賢明です。",
              "truncated": false
            },
            {
              "section": "NAD+の副作用と安全性",
              "subsection": "静脈内投与でよく報告される症状",
              "excerpt": "特に点滴速度が速い場合に、潮紅や熱感が生じます。",
              "truncated": false
            },
            {
              "section": "NAD+の副作用と安全性",
              "subsection": "静脈内投与でよく報告される症状",
              "excerpt": "点滴速度が速い場合に、胸部圧迫感や息切れが生じます。",
              "truncated": false
            },
            {
              "section": "NAD+の副作用と安全性",
              "subsection": "理論上またはより長期的な懸念",
              "excerpt": "NAD+は細胞増殖を支えるため、活動性の悪性腫瘍は禁忌です。",
              "truncated": false
            },
            {
              "section": "NAD+の副作用と安全性",
              "subsection": "理論上またはより長期的な懸念",
              "excerpt": "急性の副作用の多くは、用量と投与速度に依存します。注射を遅くすること、低い開始用量、朝の投与はいずれも、報告される忍容性の問題を減らします。",
              "truncated": false
            }
          ],
          "independent_verification": false
