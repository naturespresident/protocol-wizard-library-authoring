        "cautions": {
          "source_id": "d7553c26-f802-491d-945a-dd36ccc1f1bc",
          "source_statements": [
            {
              "section": "Tesamorelin + Ipamorelinの副作用と安全性",
              "subsection": "化合物ごとの安全性",
              "excerpt": "tesamorelinの試験で最もよく報告された有害事象には、注射部位反応（発赤、かゆみ）、関節の痛み（関節痛）、四肢の痛み、末梢浮腫（体液貯留）、筋肉痛があります。Tesamorelinは耐糖能異常や2型糖尿病のリスク上昇との関連も認められており、妊娠中は禁忌です。",
              "truncated": false
            },
            {
              "section": "Tesamorelin + Ipamorelinの副作用と安全性",
              "subsection": "化合物ごとの安全性",
              "excerpt": "Ipamorelinは、動物試験および限られたヒトのデータでは一般に忍容性が良好ですが、一過性の潮紅や頭痛が生じる可能性があります。ipamorelinはヒト試験を完了していないため、長期的な安全性は確立されていません。",
              "truncated": false
            },
            {
              "section": "Tesamorelin + Ipamorelinの副作用と安全性",
              "subsection": "スタックに特有の不明点",
              "excerpt": "この混合製剤に特有の副作用の特徴を明らかにしたヒト試験はありません。",
              "truncated": false
            },
            {
              "section": "Tesamorelin + Ipamorelinの副作用と安全性",
              "subsection": "注射部位と品質のリスク",
              "excerpt": "脂肪肥大を避けるため、腹部、大腿部、上腕の間で注射部位を順番に変えることが一般的に行われています。",
              "truncated": false
            }
          ],
          "independent_verification": false
        },
