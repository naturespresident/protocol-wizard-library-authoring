        "cautions": {
          "source_id": "d7553c26-f802-491d-945a-dd36ccc1f1bc",
          "source_statements": [
            {
              "section": "Tesamorelin + Ipamorelinの副作用と安全性",
              "subsection": "化合物ごとの安全性",
              "excerpt": "tesamorelinの試験で最も多く報告された有害事象には、注射部位反応（発赤、かゆみ）、関節の痛み（関節痛）、四肢の痛み、末梢浮腫（体液貯留）、筋肉痛があります。Tesamorelinは耐糖能異常および2型糖尿病リスクの上昇との関連も示されており、妊娠中は禁忌です。",
              "truncated": false
            },
            {
              "section": "Tesamorelin + Ipamorelinの副作用と安全性",
              "subsection": "化合物ごとの安全性",
              "excerpt": "動物研究および限られたヒトのデータでは、Ipamorelinの忍容性は概して良好ですが、一過性の潮紅や頭痛が生じることがあります。ipamorelinはヒトを対象とした試験を完了していないため、長期的な安全性は確立されていません。",
              "truncated": false
            },
            {
              "section": "Tesamorelin + Ipamorelinの副作用と安全性",
              "subsection": "スタック固有の不明点",
              "excerpt": "このブレンドに特有の副作用の特性を明らかにしたヒト試験はありません。",
              "truncated": false
            },
            {
              "section": "Tesamorelin + Ipamorelinの副作用と安全性",
              "subsection": "注射部位と品質に関するリスク",
              "excerpt": "脂肪肥厚を避けるため、腹部、大腿、上腕の間で注射部位を順に変えることが一般的に行われています。",
              "truncated": false
            }
          ],
          "independent_verification": false
        },
