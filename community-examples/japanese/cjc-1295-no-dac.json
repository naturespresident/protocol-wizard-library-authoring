        "cautions": {
          "source_id": "3105f833-8eab-4667-83d0-bb0d583ff3fd",
          "source_statements": [
            {
              "section": "CJC-1295 No DAC の対象者と使用を避けるべき人",
              "subsection": "ほとんどのプロトコルで除外される集団",
              "excerpt": "活動性のがん、または最近のがんの既往です。GHとIGF-1は細胞増殖に影響を及ぼす可能性があり、ほとんどの計画の枠組みでは、この集団を原則として除外しています。",
              "truncated": false
            },
            {
              "section": "CJC-1295 No DAC の対象者と使用を避けるべき人",
              "subsection": "ほとんどのプロトコルで除外される集団",
              "excerpt": "妊娠中または授乳中の人です。",
              "truncated": false
            },
            {
              "section": "CJC-1295 No DAC の副作用と安全性",
              "subsection": "",
              "excerpt": "CJC-1295 No DAC は、化合物自体の作用が弱まるのに伴って副作用も弱まるため、DAC製剤よりも用量漸増が容易であるとよく説明されています。報告されている作用のほとんどは、投与後30–60分以内に消失します。",
              "truncated": false
            },
            {
              "section": "CJC-1295 No DAC の副作用と安全性",
              "subsection": "よく報告される作用",
              "excerpt": "手のチクチク感やしびれがあり、高用量の単回投与との関連がみられることがあります。",
              "truncated": false
            },
            {
              "section": "CJC-1295 No DAC の副作用と安全性",
              "subsection": "理論上の長期的な懸念",
              "excerpt": "No DAC 製剤のインスリン感受性と血糖に対する長期的な影響は、十分に研究されていません。",
              "truncated": false
            },
            {
              "section": "CJC-1295 No DAC の副作用と安全性",
              "subsection": "理論上の長期的な懸念",
              "excerpt": "IGF-1の長期的な上昇は、理論上、細胞増殖に影響する可能性があり、これが、がんの既往を除外条件とする理由のひとつです。",
              "truncated": false
            }
          ],
          "independent_verification": false
        },
