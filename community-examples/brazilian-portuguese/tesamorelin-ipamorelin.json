        "cautions": {
          "source_id": "d7553c26-f802-491d-945a-dd36ccc1f1bc",
          "source_statements": [
            {
              "section": "Efeitos colaterais e segurança de Tesamorelin + Ipamorelin",
              "subsection": "Segurança de cada composto",
              "excerpt": "Nos ensaios com tesamorelin, os eventos adversos mais comumente relatados incluem reações no local da injeção (vermelhidão, coceira), dor nas articulações (artralgia), dor nas extremidades, edema periférico (retenção de líquidos) e dores musculares. Tesamorelin também foi associado à intolerância à glicose e a um risco maior de diabetes tipo 2, e é contraindicado na gravidez.",
              "truncated": false
            },
            {
              "section": "Efeitos colaterais e segurança de Tesamorelin + Ipamorelin",
              "subsection": "Segurança de cada composto",
              "excerpt": "Ipamorelin é geralmente bem tolerado em estudos com animais e nos dados limitados em humanos; podem ocorrer rubor ou dor de cabeça transitórios. Como ipamorelin não concluiu ensaios em humanos, sua segurança a longo prazo não está estabelecida.",
              "truncated": false
            },
            {
              "section": "Efeitos colaterais e segurança de Tesamorelin + Ipamorelin",
              "subsection": "Incertezas específicas da combinação",
              "excerpt": "Nenhum ensaio em humanos caracterizou o perfil de efeitos colaterais especificamente da mistura.",
              "truncated": false
            },
            {
              "section": "Efeitos colaterais e segurança de Tesamorelin + Ipamorelin",
              "subsection": "Riscos no local da injeção e relacionados à qualidade",
              "excerpt": "Alternar os locais de aplicação entre abdômen, coxa e parte superior do braço é uma prática comum para evitar lipohipertrofia.",
              "truncated": false
            }
          ],
          "independent_verification": false
        },
