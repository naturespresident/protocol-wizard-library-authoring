        "cautions": {
          "source_id": "93859e7a-a210-4d19-b4a7-cd856695aa4b",
          "source_statements": [
            {
              "section": "Para quem Melanotan 2 é indicado e quem deve evitá-lo",
              "subsection": "Histórico pessoal ou familiar de melanoma",
              "excerpt": "Relatos de casos associaram o uso de MT-2 a alterações em pintas e a diagnósticos de melanoma. Pessoas com histórico de câncer de pele ou forte histórico familiar devem evitá-lo.",
              "truncated": false
            },
            {
              "section": "Para quem Melanotan 2 é indicado e quem deve evitá-lo",
              "subsection": "Condições cardiovasculares",
              "excerpt": "Rubor, alterações da pressão arterial e relatos raros de eventos mais graves sugerem que pessoas com doença cardiovascular não controlada devem evitar o uso.",
              "truncated": false
            },
            {
              "section": "Para quem Melanotan 2 é indicado e quem deve evitá-lo",
              "subsection": "Histórico de priapismo ou traço falciforme",
              "excerpt": "Relatos de casos incluem priapismo, que é uma ereção prolongada e dolorosa que requer atendimento médico. Qualquer pessoa com risco basal mais elevado deve evitar MT-2.",
              "truncated": false
            },
            {
              "section": "Para quem Melanotan 2 é indicado e quem deve evitá-lo",
              "subsection": "Gravidez e amamentação",
              "excerpt": "Não existem dados de segurança em humanos para esses grupos. MT-2 não deve ser usado durante a gravidez ou a amamentação.",
              "truncated": false
            },
            {
              "section": "Efeitos colaterais e segurança de Melanotan 2",
              "subsection": "Dermatológicos: escurecimento de pintas e surgimento de novas pintas",
              "excerpt": "MT-2 pode escurecer pintas, sardas e outras manchas já existentes. Relatos de casos descrevem o aparecimento de novas pintas e alterações rápidas nas antigas após apenas uma ou duas doses. Como alterações em pintas às vezes podem sinalizar melanoma (um câncer de pele grave), o acompanhamento atento é importante.",
              "truncated": false
            }
          ],
          "independent_verification": false
        },
